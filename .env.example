# Quickzy Environment Variables Example
# Copy this file to .env.local and fill in the values

# --- APP CONFIG ---
NEXT_PUBLIC_URL=http://localhost:3000

# --- AUTH CONFIG (NextAuth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# --- DATABASE CONFIG ---
MONGO_URI=your_mongodb_atlas_connection_string

# --- RAZORPAY CONFIG ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# --- CLOUDINARY CONFIG ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- NEXTAUTH OAUTH PROVIDERS ---
GOOGLE_ID=your_google_id
GOOGLE_SECRET=your_google_secret

# --- EMAIL CONFIG (Brevo) ---
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=Quickzy Store <your_verified_email_here>
ADMIN_EMAIL=your_genesis_admin_email_here

# --- PREVIOUS / OPTIONAL ---
NEXT_PUBLIC_LOCATIONIQ_KEY=your_locationiq_key
